---
import Layout from "../../layout/Layout.astro";
import Header from ".././Header.astro";

const sounds = [];
for (let i = 1; i <= 13; i++) {
  sounds.push(`../../assets/audio/sound${i}.mp4`);
}
---

<Layout>
  <Header withText={false} />
  <div class="flex justify-center">
    <button>Use Sound</button>
  </div>
</Layout>
